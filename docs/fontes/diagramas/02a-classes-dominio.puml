@startuml
!pragma layout smetana
!include skin.iuml
title Diagrama de Classes — Entidades do Domínio
hide empty members
skinparam classAttributeIconSize 0

class Cliente {
  - id : UUID
  - nome : String
  - documento : String
  - tipoDocumento : TipoDocumento
  - tipoPlano : TipoPlano
  - saldo : Decimal
  - limiteMensal : Decimal
  - consumoMes : Decimal
  - ativo : Boolean
  + podeEnviar(custo : Decimal) : Boolean
  + cobrar(custo : Decimal) : void
  + estornar(valor : Decimal) : void
}
class Destinatario {
  - id : UUID
  - clienteId : UUID
  - tipo : TipoDestinatario
  - nome : String
  - telefone : String
  - aceitaOfertas : Boolean
}
class Campanha {
  - id : UUID
  - nome : String
  - conteudo : String
  - midia : Midia
  - prioridade : Prioridade
  - totalDestinatarios : Integer
  - custoTotal : Decimal
  - criadaEm : DateTime
}
class Conversa {
  - id : UUID
  - ultimaMensagem : String
  - dataUltimaMensagem : DateTime
  - naoLidas : Integer
  - statusAtendimento : StatusAtendimento
  - operadorId : UUID
  - departamentoId : UUID
  - aguardandoUra : Boolean
  - tentativasUra : Integer
  + atribuirA(operadorId : UUID) : void
  + definirDepartamento(id : UUID) : void
  + registrar(m : Mensagem) : void
  + registrarRecebida(m : Mensagem) : void
  + marcarComoLida() : void
}
class Mensagem {
  - id : UUID
  - conteudo : String
  - midia : Midia
  - prioridade : Prioridade
  - status : StatusMensagem
  - custo : Decimal
  - tentativas : Integer
  - idExterno : String
  - criadaEm : DateTime
  - automatica : Boolean
  - interna : Boolean
  - operadorId : UUID
  - contato : ContatoCompartilhado
  + {static} notaInterna(...) : Mensagem
  + iniciarProcessamento(agora) : void
  + confirmarEnvio(idExterno, agora) : void
  + confirmarEntrega(agora) : void
  + confirmarLeitura(agora) : void
  + registrarFalhaDeEnvio(maxTentativas, agora) : void
}
class Atendimento {
  - id : UUID
  - origem : OrigemAtendimento
  - status : StatusAtendimento
  - abertoEm : DateTime
  - primeiraRespostaEm : DateTime
  - finalizadoEm : DateTime
  - mensagensEnviadas : Integer
  - mensagensRecebidas : Integer
  + registrarEnvio(agora) : void
  + registrarRecebimento() : void
  + colocarEmEspera() : void
  + retomar() : void
  + finalizar(agora) : void
}
class Midia <<valor>> {
  - tipo : TipoMidia
  - url : String
  - nomeArquivo : String
  + extensao() : String
}
class ContatoCompartilhado <<valor>> {
  - nome : String
  - telefone : String
}
class Operador {
  - id : UUID
  - nome : String
  - email : String
  - senhaHash : String
  - ativo : Boolean
  - dono : Boolean
  + alterar(nome, ativo) : void
  + trocarSenha(hash) : void
}
class Transacao {
  - id : UUID
  - tipo : TipoTransacao
  - valor : Decimal
  - saldoApos : Decimal
  - dataHora : DateTime
}
class Administrador {
  - id : UUID
  - nome : String
  - login : String
  - email : String
  - telefone : String
  - senhaHash : String
}

Cliente "1" -- "0..*" Conversa
Cliente "1" -- "0..*" Destinatario
Destinatario "1" -- "0..1" Conversa
Conversa "1" *-- "0..*" Mensagem
Conversa "1" *-- "0..*" Atendimento : ciclos >
Cliente "1" -- "0..*" Campanha
Campanha "0..1" -- "1..*" Mensagem : gera >
Cliente "1" -- "0..*" Transacao
Mensagem "1" -- "0..*" Transacao : gera >
Administrador ..> Cliente : gerencia
Mensagem "0..*" --> "0..1" Midia
Campanha "0..*" --> "0..1" Midia
Mensagem "0..*" --> "0..1" ContatoCompartilhado
Cliente "1" -- "1..*" Operador : equipe >
Operador "0..1" -- "0..*" Conversa : responsável >
Operador "0..*" -- "0..*" Conversa : participa >
@enduml
