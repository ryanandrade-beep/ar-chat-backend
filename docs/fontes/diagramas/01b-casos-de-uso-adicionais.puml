@startuml
!pragma layout smetana
!include skin.iuml
left to right direction
skinparam usecase {
  BackgroundColor<<Movimentação>> #FDEBD3
  BorderColor<<Movimentação>> #B45309
  BackgroundColor<<Apoio>> #F0F0F0
  BorderColor<<Apoio>> #6B7280
  BackgroundColor<<Adicional>> #F3E8FF
  BorderColor<<Adicional>> #7C3AED
}
hide stereotype
actor "Operador\n(Atendente)" as Op
actor "Cliente\n(Empresa)" as Cli
actor "Administrador\n(Backoffice)" as Adm
rectangle "A&R Chat — funcionalidades adicionais" {
  usecase "UC16 Atender em Equipe\n(participar, nota interna, transferir)" <<Adicional>> as UC16
  usecase "UC13 Gerenciar Operadores" <<Adicional>> as UC13
  usecase "UC15 Configurar\nDepartamentos e URA" <<Adicional>> as UC15
  usecase "UC17 Painel do Gestor" <<Adicional>> as UC17
  usecase "UC14 Gerenciar Planos\ne Assinaturas" <<Adicional>> as UC14
  usecase "UC05 Realizar Atendimento" <<Movimentação>> as UC05
  usecase "URA: escolher departamento\n(ao receber mensagem)" <<Adicional>> as URA
}
Op <|-- Cli
Op --> UC05
Op --> UC16
Cli --> UC13
Cli --> UC15
Cli --> UC17
Adm --> UC14
UC16 ..> UC05 : <<extend>>
URA ..> UC05 : <<extend>>
UC15 ..> URA : configura
legend right
  <back:#FDEBD3>   </back> Movimentação (escopo principal)
  <back:#F3E8FF>   </back> Funcionalidade adicional
  Cliente (Empresa) também atende,
  por isso herda o papel de Operador.
endlegend
@enduml
