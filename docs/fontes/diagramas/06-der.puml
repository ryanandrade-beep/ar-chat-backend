@startuml
!pragma layout smetana
!include skin.iuml
title Diagrama de Entidade e Relacionamento — A&R Chat
hide circle
skinparam linetype ortho
entity conta_acesso {
  * cliente_id : uuid <<PK, FK>>
  --
  * email : varchar(160) <<UK>>
  * telefone : varchar(13)
  * senha_hash : varchar(100)
  * versao_termos : varchar(20)
  * termos_aceitos_em : timestamptz
  codigo_hash : varchar(100)
  codigo_expira_em : timestamptz
  * tentativas_codigo : integer
}
entity cliente {
  * id : uuid <<PK>>
  --
  * nome : varchar(120)
  * documento : varchar(14) <<UK>>
  * tipo_documento : varchar(4)
  * tipo_plano : varchar(10)
  * saldo : numeric(12,2)
  * limite_mensal : numeric(12,2)
  * consumo_mes : numeric(12,2)
  * ativo : boolean
  * criado_em : timestamptz
}
entity destinatario {
  * id : uuid <<PK>>
  --
  * cliente_id : uuid <<FK>>
  * nome : varchar(120)
  * telefone : varchar(40)
  * tipo : varchar(10)
  * aceita_ofertas : boolean
}
entity campanha {
  * id : uuid <<PK>>
  --
  * cliente_id : uuid <<FK>>
  * nome : varchar(120)
  * conteudo : text
  tipo_midia : varchar(10)
  url_midia : varchar(2048)
  nome_arquivo : varchar(255)
  * prioridade : varchar(10)
  * total_destinatarios : integer
  * custo_total : numeric(12,2)
  * criada_em : timestamptz
}
entity conversa {
  * id : uuid <<PK>>
  --
  * cliente_id : uuid <<FK>>
  * destinatario_id : uuid <<FK>>
  ultima_mensagem : varchar(200)
  data_ultima_mensagem : timestamptz
  * nao_lidas : integer
  * status_atendimento : varchar(12)
  operador_id : uuid <<FK>>
  departamento_id : uuid <<FK>>
  * aguardando_ura : boolean
  * tentativas_ura : integer
}
entity mensagem {
  * id : uuid <<PK>>
  --
  * conversa_id : uuid <<FK>>
  campanha_id : uuid <<FK>>
  * remetente_tipo : varchar(12)
  * conteudo : text
  tipo_midia : varchar(10)
  url_midia : varchar(2048)
  nome_arquivo : varchar(255)
  * prioridade : varchar(10)
  * status : varchar(12)
  * custo : numeric(5,2)
  * tentativas : integer
  id_externo : varchar(100) <<UK>>
  * criada_em : timestamptz
  atualizada_em : timestamptz
  * automatica : boolean
  * interna : boolean
  operador_id : uuid <<FK>>
  contato_nome : varchar(120)
  contato_telefone : varchar(20)
}
entity transacao {
  * id : uuid <<PK>>
  --
  * cliente_id : uuid <<FK>>
  mensagem_id : uuid <<FK>>
  * tipo : varchar(15)
  * valor : numeric(12,2)
  * saldo_apos : numeric(12,2)
  * data_hora : timestamptz
}
entity atendimento {
  * id : uuid <<PK>>
  --
  * conversa_id : uuid <<FK>>
  * cliente_id : uuid <<FK>>
  * origem : varchar(13)
  * status : varchar(12)
  * aberto_em : timestamptz
  iniciado_em : timestamptz
  primeira_resposta_em : timestamptz
  finalizado_em : timestamptz
  * mensagens_enviadas : integer
  * mensagens_recebidas : integer
  observacao_encerramento : varchar(500)
}
entity administrador {
  * id : uuid <<PK>>
  --
  * nome : varchar(120)
  * login : varchar(50) <<UK>>
  email : varchar(160) <<UK>>
  telefone : varchar(13)
  * senha_hash : varchar(255)
}
entity operador {
  * id : uuid <<PK>>
  --
  * cliente_id : uuid <<FK>>
  * nome : varchar(120)
  * email : varchar(160)
  * senha_hash : varchar(100)
  * ativo : boolean
  * dono : boolean
  * criado_em : timestamptz
  --
  <<UK (cliente_id, email)>>
}
entity conversa_participante {
  * conversa_id : uuid <<PK, FK>>
  * operador_id : uuid <<PK, FK>>
  --
  * desde : timestamptz
}
entity plano {
  * id : uuid <<PK>>
  --
  * nome : varchar(60) <<UK>>
  * mensalidade : numeric(10,2)
  * operadores_incluidos : integer
  * preco_normal : numeric(5,2)
  * preco_urgente : numeric(5,2)
  * ativo : boolean
  * criado_em : timestamptz
}
entity assinatura {
  * cliente_id : uuid <<PK, FK>>
  --
  * plano_id : uuid <<FK>>
  * situacao : varchar(10)
  * inicio : timestamptz
  ultima_cobranca : timestamptz
}
entity departamento {
  * id : uuid <<PK>>
  --
  * cliente_id : uuid <<FK>>
  * nome : varchar(60)
  * ativo : boolean
  * geral : boolean
  * criado_em : timestamptz
}
entity configuracao_ura {
  * cliente_id : uuid <<PK, FK>>
  --
  * ativa : boolean
  * mensagem_boas_vindas : varchar(1000)
  * mensagem_pergunta : varchar(1000)
  * maximo_tentativas : integer
  departamento_padrao_id : uuid <<FK>>
  * ignorar_grupos : boolean
}
entity arquivo {
  * id : uuid <<PK>>
  --
  * cliente_id : uuid <<FK>>
  * nome : varchar(255)
  * tipo_mime : varchar(120)
  * tamanho : integer
  * conteudo : bytea
  * criado_em : timestamptz
}
entity instancia_whatsapp {
  * cliente_id : uuid <<PK, FK>>
  --
  * instancia : varchar(64) <<UK>>
  * token : varchar(128)
  * vinculada_em : timestamptz
}
entity destinatario_etiqueta {
  * destinatario_id : uuid <<PK, FK>>
  * etiqueta : varchar(30) <<PK>>
}
entity campanha_envio {
  * campanha_id : uuid <<PK, FK>>
  --
  agendada_para : timestamptz
  * intervalo_segundos : integer
  etiqueta : varchar(30)
}
entity liberacao_pendente {
  * mensagem_id : uuid <<PK, FK>>
  --
  * liberar_em : timestamptz
}
entity operador_departamento {
  * operador_id : uuid <<PK, FK>>
  * departamento_id : uuid <<PK, FK>>
}
entity entrega {
  * id : uuid <<PK>>
  --
  * cliente_id : uuid <<FK>>
  * destinatario_id : uuid <<FK>>
  * conversa_id : uuid <<FK>>
  operador_id : uuid
  mensagem_id : uuid
  * nome_cliente : varchar(120)
  * telefone : varchar(40)
  * endereco : varchar(300)
  * pedido : varchar(1000)
  valor : numeric(10,2)
  pagamento : varchar(20)
  observacao : varchar(500)
  * status : varchar(12)
  * origem : varchar(10)
  * criada_em : timestamptz
  saiu_em : timestamptz
  entregue_em : timestamptz
  cancelada_em : timestamptz
  motivo_cancelamento : varchar(300)
}
entity entrega_item {
  * entrega_id : uuid <<PK, FK>>
  * posicao : integer <<PK>>
  --
  produto_id : varchar(60)
  * nome : varchar(200)
  * quantidade : integer
  * valor_unitario : numeric(10,2)
  imagem : varchar(1000)
}
entity configuracao_entrega {
  * cliente_id : uuid <<PK, FK>>
  --
  * avisar_saida : boolean
  * mensagem_saida : varchar(500)
  * avisar_entregue : boolean
  * mensagem_entregue : varchar(500)
  pix_chave : varchar(140)
  * aceita_cartao : boolean
}
entity integracao_webhook {
  * cliente_id : uuid <<PK, FK>>
  --
  * url : varchar(500)
  * segredo : varchar(100)
  * eventos : varchar(500)
  * ativa : boolean
  * atualizada_em : timestamptz
}
entity integracao_envio {
  * id : uuid <<PK>>
  --
  * cliente_id : uuid <<FK>>
  * evento : varchar(60)
  * payload : text
  * status : varchar(12)
  * tentativas : integer
  http_status : integer
  proxima_tentativa : timestamptz
  * criado_em : timestamptz
  enviado_em : timestamptz
}
entity auditoria {
  * id : uuid <<PK>>
  --
  * cliente_id : uuid <<FK>>
  autor_id : uuid
  * autor_nome : varchar(120)
  * acao : varchar(60)
  recurso : varchar(200)
  detalhe : varchar(500)
  * criada_em : timestamptz
}
cliente ||--o| conta_acesso
cliente ||--o{ conversa
cliente ||--o{ destinatario
destinatario ||--o| conversa
conversa ||--o{ mensagem
cliente ||--o{ transacao
mensagem |o--o{ transacao
cliente ||--o{ campanha
conversa ||--o{ atendimento
cliente ||--o{ atendimento
campanha |o--o{ mensagem
cliente ||--|{ operador
operador |o--o{ conversa
conversa ||--o{ conversa_participante
operador ||--o{ conversa_participante
operador |o--o{ mensagem
plano ||--o{ assinatura
cliente ||--o| assinatura
cliente ||--o{ departamento
departamento |o--o{ conversa
cliente ||--o| configuracao_ura
departamento |o--o{ configuracao_ura
cliente ||--o{ arquivo
cliente ||--o| instancia_whatsapp
destinatario ||--o{ destinatario_etiqueta
campanha ||--o| campanha_envio
mensagem ||--o| liberacao_pendente
operador ||--o{ operador_departamento
departamento ||--o{ operador_departamento
cliente ||--o{ entrega
conversa ||--o{ entrega
destinatario ||--o{ entrega
entrega ||--o{ entrega_item
cliente ||--o| configuracao_entrega
cliente ||--o| integracao_webhook
cliente ||--o{ integracao_envio
cliente ||--o{ auditoria
@enduml
